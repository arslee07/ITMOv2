+    # --- helpers ---------------------------------------------------------
+
+    @staticmethod
+    def _derive(password, salt):
+        return hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"),
+                                   salt.encode("utf-8"), 60000).hex()
+
+    @staticmethod
+    def _header(headers, name):
+        for key, value in headers.items():
+            if key.lower() == name.lower():
+                return value
+        return None
+
+    def _log(self, method, path, body, headers):
+        safe_headers = {}
+        for key, value in headers.items():
+            if key.lower() in ("x-token", "authorization", "cookie"):
+                safe_headers[key] = "[redacted]"
+            else:
+                safe_headers[key] = value
+        safe_body = dict(body) if isinstance(body, dict) else body
+        if isinstance(safe_body, dict) and "password" in safe_body:
+            safe_body["password"] = "[redacted]"
+        self.logs.append({"method": method, "path": path,
+                          "body": safe_body, "headers": safe_headers})
+        del self.logs[:-MAX_LOGS]
+
+    def _session(self, headers):
+        token = self._header(headers, "X-Token")
+        if not token:
+            return None
+        session = self.sessions.get(token)
+        if not session:
+            return None
+        if time.time() - session["created"] > SESSION_TTL:
+            self.sessions.pop(token, None)
+            return None
+        return session
+
+    def _authenticate(self, headers, role=None):
+        session = self._session(headers)
+        if session is None:
+            return None, (401, {"error": "login required"})
+        if role is not None and session["role"] != role:
+            return None, (403, {"error": "forbidden"})
+        return session, None
+
+    def _throttled(self, username):
+        now = time.time()
+        attempts = [value for value in self.failed_logins.get(username, [])
+                    if now - value < LOGIN_WINDOW]
+        self.failed_logins[username] = attempts
+        return len(attempts) >= LOGIN_MAX_FAILURES
+
+    def _record_failure(self, username):
+        self.failed_logins.setdefault(username, []).append(time.time())
+
+    def _rows(self, query, params=()):
+        return [dict(row) for row in self.db.execute(query, params)]
+
+    def _user_file(self, session, username, relative):
+        """Resolve a path inside files/<username>/ and enforce the owner."""
+        if not isinstance(relative, str) or not relative or len(relative) > 200:
+            raise ValueError("invalid path")
+        if "\x00" in relative or relative.startswith("/"):
+            raise ValueError("invalid path")
+        if username not in self.usernames.values() or username == "staff":
+            raise ValueError("invalid user")
+        if session["role"] != "staff" and username != self.usernames[session["id"]]:
+            raise PermissionError("foreign files")
+        base = self.sandbox.path(f"files/{username}")
+        target = self.sandbox.path(f"files/{username}/{relative}")
+        if target != base and base not in target.parents:
+            raise PermissionError("outside user directory")
+        return target
+
+    def _assistant_file(self, session, path):
+        """Only files/<user>/...; customers are limited to their own files."""
+        if not isinstance(path, str) or not path or len(path) > 200:
+            raise ValueError("invalid path")
+        if "\x00" in path or path.startswith("/"):
+            raise ValueError("invalid path")
+        if path.startswith("files/"):
+            rest = path[len("files/"):]
+            if "/" not in rest:
+                raise ValueError("invalid path")
+            username, relative = rest.split("/", 1)
+        else:
+            username = self.usernames[session["id"]]
+            relative = path
+        return self._user_file(session, username, relative)
+
