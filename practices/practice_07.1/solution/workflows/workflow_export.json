      "id": "470ba6f4-4f7a-4efb-8aac-4d7a0acf2a02",
      "name": "AI review (secondary)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        1248,
        176
      ]
