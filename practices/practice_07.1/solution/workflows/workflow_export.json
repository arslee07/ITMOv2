    {
      "parameters": {
        "jsCode": "// Приводим события GitHub к одному виду: repo / pr / model\nconst body = $('GitHub Trigger').first().json.body;\nconst isPrEvent = Boolean(body.pull_request);\nconst pr = isPrEvent ? body.pull_request.number : body.issue.number;\nconst repo = body.repository.full_name;\nconst cmd = (body.comment && body.comment.body ? body.comment.body : '').trim();\nconst model = cmd.startsWith('/make_other_ai_review') ? 'secondary' : 'primary';\n\nreturn [{ json: { repo, pr, model, event: isPrEvent ? 'pull_request' : 'issue_comment', command: cmd } }];"
      },
