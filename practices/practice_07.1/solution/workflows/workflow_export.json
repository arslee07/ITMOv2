    {
      "parameters": {
        "jsCode": "// Разбираем ответ модели и оставляем только валидные точечные замечания\nconst raw = $input.first().json.output ?? $input.first().json.text ?? '';\nconst meta = $('Build blocks').first().json;\n\nconst strip = String(raw).trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\nlet parsed = [];\ntry {\n  const data = JSON.parse(strip);\n  parsed = Array.isArray(data) ? data : (data.comments || data.findings || []);\n} catch (e) {\n  parsed = [];\n}\n\nconst valid = new Set();\nfor (const [path, lines] of Object.entries(meta.validLines || {})) {\n  for (const line of lines) valid.add(`${path}:${line}`);\n}\n\nconst seen = new Set();\nconst items = [];\nfor (const c of parsed) {\n  const path = String(c.path || c.file || '');\n  const line = Number(c.line);\n  const body = String(c.body || c.comment || '').trim();\n  if (!path || !Number.isFinite(line) || !body) continue;\n  const key = `${path}:${line}`;\n  if (!valid.has(key) || seen.has(key)) continue;\n  seen.add(key);\n  items.push({ json: { path, line, body: body.slice(0, 1800), repo: meta.repo, pr: meta.pr, model: meta.model } });\n}\n\nreturn items;"
      },
