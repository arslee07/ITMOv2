    {
      "parameters": {
        "jsCode": "// Режем diff PR на блоки изменённого кода и считаем номера строк в новой версии файла\nconst files = $input.all().map(i => i.json);\nconst meta = $('Prepare').first().json;\n\nconst MAX_CHARS = 60000;   // сколько кода максимум отдаём модели\nconst MAX_BLOCKS = 80;\n\nconst blocks = [];\nconst validLines = {};\n\nfor (const file of files) {\n  if (!file.patch) continue; // бинарники и переименования без текстового diff\n  const lines = String(file.patch).split('\\n');\n  let newLine = 0;\n  let current = null;\n\n  const flush = () => {\n    if (current && current.lines.length) {\n      blocks.push({\n        path: current.path,\n        start_line: current.lines[0].line,\n        end_line: current.lines[current.lines.length - 1].line,\n        code: current.lines.map(l => `${l.line}: ${l.text}`).join('\\n'),\n      });\n    }\n    current = null;\n  };\n\n  for (const line of lines) {\n    const hunk = line.match(/^@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n    if (hunk) {\n      flush();\n      newLine = parseInt(hunk[1], 10);\n      continue;\n    }\n    if (line.startsWith('+++') || line.startsWith('---')) continue;\n    if (line.startsWith('+')) {\n      if (!current) current = { path: file.filename, lines: [] };\n      current.lines.push({ line: newLine, text: line.slice(1) });\n      (validLines[file.filename] = validLines[file.filename] || []).push(newLine);\n      newLine++;\n    } else if (line.startsWith('-')) {\n      // удалённые строки не занимают места в новой версии файла\n    } else if (line.startsWith(' ')) {\n      flush();\n      newLine++;\n    }\n  }\n  flush();\n}\n\n// бюджет по символам, чтобы не улететь в контекст модели\nconst picked = [];\nlet used = 0;\nfor (const b of blocks) {\n  if (picked.length >= MAX_BLOCKS) break;\n  if (used + b.code.length > MAX_CHARS) break;\n  used += b.code.length;\n  picked.push({ block: picked.length + 1, path: b.path, start_line: b.start_line, end_line: b.end_line, code: b.code });\n}\n\nconst prompt = [\n  'Ты senior-ревьюер. Ниже блоки изменённого кода из pull request.',\n  'Найди только реальные проблемы: баги, безопасность, регрессии, производительность, нарушения best practices.',\n  'Не придирайся к стилю и не выдумывай проблемы. Если в блоке всё нормально — не пиши по нему ничего.',\n  '',\n  'Верни СТРОГО JSON-массив без markdown и без пояснений. Формат элемента:',\n  '{\"path\": \"путь/из/заголовка\", \"line\": 42, \"body\": \"что не так и как исправить (1-3 предложения)\"}',\n  '',\n  'line — это номер строки из чисел слева от кода. Используй только эти номера.',\n  '',\n  JSON.stringify(picked),\n].join('\\n');\n\nreturn [{ json: {\n  repo: meta.repo,\n  pr: meta.pr,\n  model: meta.model,\n  blocks_total: blocks.length,\n  blocks_used: picked.length,\n  validLines,\n  prompt,\n} }];"
      },
