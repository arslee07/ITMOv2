# Скопируйте в .env и заполните при необходимости. Файл .env в git не попадает.

# Порт API и статики в production-режиме (npm start).
PORT=8787

# Режим классификатора: heuristic | llm | n8n.
# heuristic — работает без сети и ключей (по умолчанию).
# llm       — запрос к OpenAI-совместимому API (VseLLM).
# n8n       — запрос к webhook вашего n8n-сценария.
CLASSIFIER=heuristic

# VseLLM (OpenAI-совместимый шлюз из практик 7.1/7.2).
VSELLM_BASE_URL=https://litellm.data-light.ru/v1
VSELLM_API_KEY=
VSELLM_MODEL=openai/gpt-5.2

# Для CLASSIFIER=n8n: URL webhook, который принимает {title, body}
# и возвращает {type, confidence}.
N8N_WEBHOOK_URL=

# Задержка ответа API в миллисекундах — чтобы состояние загрузки было видно на демо.
API_DELAY_MS=450

# Принудительная ошибка API для демонстрации состояния ошибки: 1 / 0.
SIMULATE_ERROR=0

# Файл хранилища тикетов.
DATA_FILE=var/tickets.json
