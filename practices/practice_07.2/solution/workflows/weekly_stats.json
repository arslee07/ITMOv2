    {
      "parameters": {
        "jsCode": "// Итоговое HTML-письмо с Δ и AI-комментарием\nconst s = $('Compute delta').first().json;\nconst aiRaw = $('AI annotation').first().json;\nconst ai = String(aiRaw.text ?? aiRaw.output ?? '').trim();\n\nconst esc = (v) => String(v).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst fmt = (v) => (v === null ? '—' : (v > 0 ? `+${v}` : `${v}`));\n\nconst row = (k, v, d) => `<tr><td>${esc(k)}</td><td align=\"right\"><b>${esc(v)}</b></td><td align=\"right\">${esc(fmt(d))}</td></tr>`;\nconst row2 = (k, v) => `<tr><td>${esc(k)}</td><td align=\"right\"><b>${esc(v)}</b></td></tr>`;\n\nconst html = `\n<h2>Статистика за неделю</h2>\n<p>${esc($now.minus({ days: 7 }).startOf('day').toFormat('yyyy-LL-dd'))} — ${esc($now.toFormat('yyyy-LL-dd'))}</p>\n${ai ? `<blockquote><b>AI-комментарий недели:</b><br>${esc(ai).replace(/\\n/g, '<br>')}</blockquote>` : ''}\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\">\n  <tr><th align=\"left\">Метрика</th><th>Значение</th><th>Δ к прошлой</th></tr>\n  ${row('Issues создано', s.issues_opened, s.delta.issues_opened)}\n  ${row('Issues закрыто', s.issues_closed, s.delta.issues_closed)}\n  ${row('PR открыто', s.prs_opened, s.delta.prs_opened)}\n  ${row('PR смержено', s.prs_merged, s.delta.prs_merged)}\n</table>\n<h3>По типам</h3>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\">\n  ${row2('bug', s.by_type.bug)}\n  ${row2('feature', s.by_type.feature)}\n  ${row2('task', s.by_type.task)}\n  ${row2('other', s.by_type.other)}\n</table>\n<h3>По авторам</h3>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\">\n  ${s.by_author.map((a) => row2(a.login, a.count)).join('') || '<tr><td colspan=\"2\">нет активности</td></tr>'}\n</table>\n${s.has_prev ? `<p><small>${esc(s.prev_text)}</small></p>` : `<p><small>${esc(s.prev_text)}</small></p>`}\n`;\n\nreturn [{ json: { html } }];"
      },
