    {
      "parameters": {
        "jsCode": "// Считаем Δ к прошлой неделе\nconst cur = $('Group stats').first().json;\nconst prevRaw = $('Get previous week').first().json || {};\nconst hasPrev = typeof prevRaw.week_start === 'string' && prevRaw.week_start.length > 0;\n\nconst num = (v) => (typeof v === 'number' ? v : Number(v) || 0);\nconst diff = (key) => (hasPrev ? num(cur[key]) - num(prevRaw[key]) : null);\nconst fmt = (v) => (v === null ? '—' : (v > 0 ? `+${v}` : `${v}`));\n\nconst delta = {\n  issues_opened: diff('issues_opened'),\n  issues_closed: diff('issues_closed'),\n  prs_opened: diff('prs_opened'),\n  prs_merged: diff('prs_merged'),\n};\n\nconst prevText = hasPrev\n  ? `Прошлая неделя: issues +${prevRaw.issues_opened}, closed ${prevRaw.issues_closed}, PR +${prevRaw.prs_opened}, merged ${prevRaw.prs_merged}.`\n  : 'Прошлой недели в таблице нет — это первая запись, Δ считать не с чем.';\n\nconst llm_prompt = `Ты аналитик Open Source проекта. Напиши 2-3 предложения о том, что изменилось за неделю, опираясь только на эти цифры.\n\nТекущая неделя: issues создано ${cur.issues_opened}, закрыто ${cur.issues_closed}, PR открыто ${cur.prs_opened}, смержено ${cur.prs_merged}.\nПо типам: bug ${cur.by_type.bug}, feature ${cur.by_type.feature}, task ${cur.by_type.task}, other ${cur.by_type.other}.\n${prevText}\nΔ issues: ${fmt(delta.issues_opened)}, Δ closed: ${fmt(delta.issues_closed)}, Δ PR: ${fmt(delta.prs_opened)}, Δ merged: ${fmt(delta.prs_merged)}.\n\nБез вступлений и списков, только вывод.`;\n\nreturn [{ json: { ...cur, has_prev: hasPrev, prev: hasPrev ? prevRaw : null, delta, prev_text: prevText, llm_prompt } }];"
      },
