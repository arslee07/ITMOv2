    {
      "parameters": {
        "jsCode": "// Собираем статистику за последние 7 дней\nconst startMs = $now.minus({ days: 7 }).startOf('day').toMillis();\nconst endMs = $now.toMillis();\n\nconst within = (iso) => {\n  if (!iso) return false;\n  const t = new Date(iso).getTime();\n  return Number.isFinite(t) && t >= startMs && t <= endMs;\n};\n\nconst uniq = (items) => {\n  const seen = new Set();\n  return items.filter((x) => {\n    if (seen.has(x.id)) return false;\n    seen.add(x.id);\n    return true;\n  });\n};\n\nconst issuesAll = uniq($('Issues created').all().map((i) => i.json)).filter((x) => !x.pull_request);\nconst issuesCreated = issuesAll.filter((x) => within(x.created_at));\nconst issuesClosed = uniq($('Issues closed').all().map((i) => i.json))\n  .filter((x) => !x.pull_request && within(x.closed_at));\n\nconst prsOpened = uniq($('PRs opened').all().map((i) => i.json)).filter((x) => within(x.created_at));\nconst prsMerged = uniq($('PRs merged').all().map((i) => i.json)).filter((x) => within(x.merged_at));\n\nconst typeOf = (issue) => {\n  const labels = (issue.labels || []).map((l) => (typeof l === 'string' ? l : l.name));\n  if (labels.includes('bug')) return 'bug';\n  if (labels.includes('feature-request')) return 'feature';\n  if (labels.includes('task')) return 'task';\n  return 'other';\n};\n\nconst byType = { bug: 0, feature: 0, task: 0, other: 0 };\nfor (const issue of issuesCreated) byType[typeOf(issue)]++;\n\nconst authors = {};\nconst bump = (login) => { authors[login] = (authors[login] || 0) + 1; };\nfor (const x of issuesCreated) bump(x.user?.login || 'unknown');\nfor (const x of prsOpened) bump(x.user?.login || 'unknown');\n\nconst byAuthor = Object.entries(authors)\n  .sort((a, b) => b[1] - a[1])\n  .map(([login, count]) => ({ login, count }));\n\nreturn [{\n  json: {\n    week_start: $now.minus({ days: 7 }).startOf('day').toISO(),\n    week_end: $now.toISO(),\n    issues_opened: issuesCreated.length,\n    issues_closed: issuesClosed.length,\n    prs_opened: prsOpened.length,\n    prs_merged: prsMerged.length,\n    by_type: byType,\n    by_author: byAuthor,\n  },\n}];"
      },
