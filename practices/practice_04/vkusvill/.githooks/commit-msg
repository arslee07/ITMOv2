#!/usr/bin/env bash
# Git commit-msg hook: enforces conventional commits

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\-]+\))?: .+"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo "❌ [commit-msg] Ошибка: Неверный формат коммит-сообщения!"
    echo "Сообщение: \"$COMMIT_MSG\""
    echo ""
    echo "💡 Используйте формат Conventional Commits:"
    echo "   feat: описание новой функциональности"
    echo "   fix: исправление бага"
    echo "   docs: обновление документации"
    echo "   test: добавление или изменение тестов"
    echo "   refactor: рефакторинг кода"
    echo "   chore: рутинные задачи или настройки"
    exit 1
fi

exit 0
